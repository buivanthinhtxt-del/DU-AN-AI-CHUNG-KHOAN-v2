# Sao chép file này thành .env và điền khóa API thật của bạn ở máy local.
# Không commit file .env lên Git.
GEMINI_API_KEY=your_gemini_api_key_here

# (Tùy chọn) Thứ tự model Gemini ưu tiên, cách nhau bằng dấu phẩy
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# --- Nguồn dữ liệu giá (backend/data_sources.py) ---
# Thứ tự thử: ssi = API chính thức SSI FastConnect · public = API công khai bảng giá các CTCK (không cần đăng ký)
#             vnstock = thư viện cũ · local = kho CSV backend/data/ohlcv
DATA_SOURCES=ssi,public,vnstock,local

# Thứ tự xoay vòng các nguồn công khai (không chính thức, có thể bị đổi/chặn). Đặt DISABLE_PUBLIC_SOURCES=1 để tắt.
PUBLIC_SOURCES=dnse,vndirect,ssi_iboard,vci,kbs

# SSI FastConnect Data — miễn phí cho chủ tài khoản SSI, nhưng phải đăng ký tại quầy hoặc qua môi giới
# (hotline 1900 5454 71). Sau khi được duyệt, tạo khóa tại iBoard → Dịch vụ API:
# https://iboard.ssi.com.vn/support/api-service/management
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=

# Đặt =1 để bỏ qua hẳn vnstock (VD khi thư viện đã ngừng hoạt động, tránh mất thời gian thử)
DISABLE_VNSTOCK=
