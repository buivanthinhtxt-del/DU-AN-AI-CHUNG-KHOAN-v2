# Sao chép file này thành .env và điền khóa API thật của bạn ở máy local.
# Không commit file .env lên Git.
GEMINI_API_KEY=your_gemini_api_key_here

# (Tùy chọn) Thứ tự model Gemini ưu tiên, cách nhau bằng dấu phẩy
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# --- Nguồn dữ liệu giá (backend/data_sources.py) ---
# Thứ tự thử: ssi = API chính thức SSI FastConnect · vnstock = thư viện cũ · local = kho CSV backend/data/ohlcv
DATA_SOURCES=ssi,vnstock,local

# SSI FastConnect Data — miễn phí cho chủ tài khoản SSI.
# Lấy khóa tại iBoard → Dịch vụ API: https://iboard.ssi.com.vn/support/api-service/management
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=

# Đặt =1 để bỏ qua hẳn vnstock (VD khi thư viện đã ngừng hoạt động, tránh mất thời gian thử)
DISABLE_VNSTOCK=
